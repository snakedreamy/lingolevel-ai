{
  "name": "lingolevel-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "predev": "npm run validate:data",
    "dev": "tsx watch server/index.ts",
    "build": "npm run validate:data && vite build && esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "npm run validate:data && npm run test:providers && npm run test:storage && npm run test:fill-blank && npm run test:tts",
    "validate:data": "tsx src/data/learningData.selftest.ts && tsx server/learningPractice.selftest.ts",
    "test:providers": "tsx providers/openai-compatible.selftest.ts",
    "test:storage": "tsx src/lib/chatSessionStorage.selftest.ts",
    "test:fill-blank": "tsx server/fillBlank.selftest.ts && tsx src/hooks/useFillBlankPractice.selftest.ts",
    "test:tts": "tsx src/lib/tts/fallback.selftest.ts && tsx src/lib/tts/api.selftest.ts && tsx providers/tts/mimo.selftest.ts"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "undici": "^8.10.2",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2"
  }
}
