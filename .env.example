# lingolevel-ai configuration
# Copy this file to .env.local and fill in real values.

# ⚠ API Keys live ONLY in this file (or your real env). They are NEVER
# sent to the browser. The browser can echo Provider/Base URL/Model
# names via /api/server-config, but the ServerConfig response is
# verified to NOT contain an apiKey field.

# Note: Do NOT wrap values in quotes.
# dotenv (local dev) strips quotes automatically, but Docker/Podman
# --env-file passes values literally, which would break validation.

# === Provider selection ===
# Which protocol to use. One of: openai | anthropic
PROVIDER=openai

# === OpenAI-compatible ===
# Works with OpenAI official, Groq, DeepSeek, OpenRouter, 硅基流动,
# self-hosted vLLM, Ollama (http://localhost:11434/v1), etc.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=your-openai-compatible-chat-model
OPENAI_ANALYZE_MODEL=your-openai-compatible-analyze-model
# Optional comma-separated model allowlist shown in the web settings.
# The two default models above are always included automatically.
OPENAI_MODELS=gpt-4o-mini,gpt-4.1-mini
# Optional HTTP/SOCKS proxy for this provider only (empty = direct).
# Useful when this API needs a proxy but the other provider must not use one.
# Examples: http://127.0.0.1:7890  http://user:pass@host:8080  socks5://127.0.0.1:1080
OPENAI_PROXY=

# === Anthropic ===
ANTHROPIC_API_KEY=sk-ant-...
# Anthropic 请求拒绝重定向，请填写最终 API 地址。
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_CHAT_MODEL=claude-opus-5
ANTHROPIC_ANALYZE_MODEL=claude-opus-5
ANTHROPIC_MODELS=claude-opus-5,claude-sonnet-5,claude-haiku-4-5
# Same idea as OPENAI_PROXY — applies only to Anthropic requests.
ANTHROPIC_PROXY=

# === Text-to-speech fallback ===
# The browser's built-in speech engine is used first. Set this to mimo to let
# unsupported browsers call the server-side /api/tts fallback. Use none to disable it.
TTS_PROVIDER=none
TTS_MAX_TEXT_CHARS=5000
TTS_TIMEOUT_MS=30000

# MiMo-specific adapter settings. MIMO_TTS_API_KEY remains server-only.
MIMO_TTS_API_KEY=
MIMO_TTS_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE_ZH=冰糖
MIMO_TTS_VOICE_EN_US=Mia
MIMO_TTS_VOICE_EN_GB=Mia
# Optional HTTP/SOCKS proxy for MiMo TTS only (empty = direct).
MIMO_TTS_PROXY=

# === Server port ===
# Defaults to 59100. Set in .env.local to use a different port.
PORT=59100

# 默认不信任代理（留空/未设置）。使用反向代理时，仅列出实际可信代理的
# IP/CIDR，使用逗号分隔，例如 127.0.0.1,::1。
# 不接受布尔值、代理跳数或 loopback/linklocal/uniquelocal 等别名。
# 不会自动信任私网。应限制非预期的服务端口直连，并让代理覆盖转发头。
# 未配置时，代理后的用户会共享代理 IP 的限流额度。
TRUST_PROXY=

# === Common ===
# Shared by chat, follow-up questions, analysis and fill-blank generation.
# No arbitrary application-level ceiling is applied to either value.
REQUEST_TIMEOUT_MS=180000
MAX_OUTPUT_TOKENS=32768

# Maximum number of recent user/assistant messages sent back to the model
# as conversation context. Increase for longer memory, decrease for lower
# token cost and faster requests.
MAX_CONTEXT_MESSAGES=12

# === Fill-blank workflow ===
# These control card batching and structured-output validation, not model capacity.
FILL_BLANK_BATCH_SIZE=10
FILL_BLANK_ATTEMPTS=2

# === App URL (used for self-referential links, OAuth callbacks) ===
# Match this to the port you set in PORT above.
APP_URL=http://localhost:59100
